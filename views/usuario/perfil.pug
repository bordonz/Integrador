extends ../layout.pug

block metadata
  title Perfil
  link(rel='stylesheet', href='/perfil.css')
  link(rel="stylesheet", href="/gallery.css")

block content
  .perfil-container
    .perfil-header
      h1 #{usuario.firstName} #{usuario.lastName}
      if estaSeguido
        form(action=`/seguir/${usuario.id_usuario}/unfollow`, method="POST")
          button(type="submit") No seguir
      else
        form(action=`/seguir/${usuario.id_usuario}`, method="POST")
          button(type="submit") Seguir

      .perfil-stats
        .stat-box Seguidores #{usuario.Seguidores.length}
        .stat-box Siguiendo #{usuario.Seguidos.length}
      if currentUser && currentUser.id_usuario === usuario.id_usuario
        form(action='/guardados/mostrar', method="GET")
          button(type="submit")
            svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-bookmark" viewBox="0 0 16 16")
              path(d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v13.5a.5.5 0 0 1-.777.416L8 13.101l-5.223 2.815A.5.5 0 0 1 2 15.5zm2-1a1 1 0 0 0-1 1v12.566l4.723-2.482a.5.5 0 0 1 .554 0L13 14.566V2a1 1 0 0 0-1-1z")
  .perfil-publicaciones
    if usuario.Publicacions.length
      include ../galleryPartial.pug
    else
      p.no-publicaciones No tiene publicaciones aún.
