extends ../layout.pug

block metadata
  title Perfil
  link(rel='stylesheet', href='/perfil.css')
  link(rel="stylesheet", href="/gallery.css")

block content
  .perfil-container
    .perfil-header
      h1 #{usuario.firstName} #{usuario.lastName}
      if estaSeguido
        form(action=`/seguir/${usuario.id_usuario}/unfollow`, method="POST")
          button(type="submit") No seguir
      else
        form(action=`/seguir/${usuario.id_usuario}`, method="POST")
          button(type="submit") Seguir

      .perfil-stats
        .stat-box Seguidores #{usuario.Seguidores.length}
        .stat-box Siguiendo #{usuario.Seguidos.length}

  .perfil-publicaciones
    if usuario.Publicacions.length
      include ../galleryPartial.pug
    else
      p.no-publicaciones No tiene publicaciones aún.
