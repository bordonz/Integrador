extends ../layout.pug

block metadata
  title Perfil
  link(rel='stylesheet', href='/perfil.css')
  link(rel="stylesheet", href="/gallery.css")

block content
    form(action='/guardados/crearColeccion', method="POST")
        input(type="text", name="nombre")
        button(type="submit")
    .perfil-publicaciones
        if publicaciones && publicaciones.length
            include ../galleryPartial.pug
        else
            p.no-publicaciones No tiene publicaciones guardadas.
