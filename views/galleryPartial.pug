    script.
      document.addEventListener('DOMContentLoaded', function() {
        // Inicializar carruseles para cada publicación
        const carruseles = document.querySelectorAll('.gallery-item');
        
        carruseles.forEach((carrusel, idx) => {
          const slides = carrusel.querySelectorAll('.carrusel-slide');
          const prevBtn = carrusel.querySelector('.prev');
          const nextBtn = carrusel.querySelector('.next');
          
          if (slides.length === 0) return;
          
          let currentIndex = 0;
          
          function showSlide(index) {
            slides.forEach((slide, i) => {
              slide.classList.remove('active');
              if (i === index) {
                slide.classList.add('active');
              }
            });
          }
          
          function nextSlide() {
            currentIndex = (currentIndex + 1) % slides.length;
            showSlide(currentIndex);
          }
          
          function prevSlide() {
            currentIndex = (currentIndex - 1 + slides.length) % slides.length;
            showSlide(currentIndex);
          }
          
          if (prevBtn) prevBtn.addEventListener('click', prevSlide);
          if (nextBtn) nextBtn.addEventListener('click', nextSlide);
        });
      });

    script.
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.ver-comentarios').forEach(btn => {
          btn.addEventListener('click', () => {
            const panel = btn.closest('.gallery-item').querySelector('.comentarios-panel');
            if (panel.style.display === 'none') {
              panel.style.display = 'block';
            } else {
              panel.style.display = 'none';
            }
          });
        });
      });

    script.
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.comentarios-panel').forEach(panel => {
          const btnCerrar = panel.querySelector('.cerrar-panel');
          btnCerrar.addEventListener('click', () => {
            panel.style.display = 'none';
          });
        });
      });

    //panel de reporte
    script.
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.ver-reporte').forEach(btn => {
          btn.addEventListener('click', () => {
            // 1. Buscamos primero si el reporte está dentro de un comentario (.comentarios-box)
            // 2. Si no es un comentario, buscará el de la imagen dentro de (.gallery-item)
            const contenedorComentario = btn.closest('.comentarios-box');
            let panel;

            if (contenedorComentario) {
              // Si el botón está dentro de un comentario, abrimos SU panel específico
              panel = contenedorComentario.querySelector('.reporte-panel');
            } else {
              // Si no, es el botón de la imagen, buscamos el de la imagen dentro del item de galería
              panel = btn.closest('.gallery-item').querySelector('.reporte-panel');
            }

            if (panel) {
              if (panel.style.display === 'none' || panel.style.display === '') {
                panel.style.display = 'block';
              } else {
                panel.style.display = 'none';
              }
            }
          });
        });
      });
      
    script.
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.reporte-panel').forEach(panel => {
          const btnCerrar = panel.querySelector('.cerrar-panel');
          btnCerrar.addEventListener('click', () => {
            panel.style.display = 'none';
          });
        });
      });

    //Cerrar comentarios
    script.
      document.addEventListener('DOMContentLoaded', () => {
        const btnsComentar = document.querySelectorAll('.btn-comentar');

        btnsComentar.forEach(btnComentar => {
          const estado = btnComentar.dataset.estado === 'true';
          console.log('Valor de data-estado:', btnComentar.dataset.estado);
          console.log('Estado convertido a boolean:', estado);
          if(estado) {  // ← Cambiar btnComentar por estado
            btnComentar.disabled = false;
            btnComentar.style.backgroundColor = '#4455cc';
          } else {
            btnComentar.disabled = true;
            btnComentar.style.backgroundColor = '#dc3545';
          }
        });
      });

