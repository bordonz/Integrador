extends ../layout.pug
block metadata 
    title Subir Publicacion
    link(rel='stylesheet', href='/publicar.css')
block content
  div#imgsPreview
  form(action="/publicacion/crearPublicacion" method="post" class="form-publicacion")
    div.titulo-izq
      button(type="button")
        svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-folder-plus" viewBox="0 0 16 16")
          path(d="m.5 3 .04.87a2 2 0 0 0-.342 1.311l.637 7A2 2 0 0 0 2.826 14H9v-1H2.826a1 1 0 0 1-.995-.91l-.637-7A1 1 0 0 1 2.19 4h11.62a1 1 0 0 1 .996 1.09L14.54 8h1.005l.256-2.819A2 2 0 0 0 13.81 3H9.828a2 2 0 0 1-1.414-.586l-.828-.828A2 2 0 0 0 6.172 1H2.5a2 2 0 0 0-2 2m5.672-1a1 1 0 0 1 .707.293L7.586 3H2.19q-.362.002-.683.12L1.5 2.98a1 1 0 0 1 1-.98z")
          path(d="M13.5 9a.5.5 0 0 1 .5.5V11h1.5a.5.5 0 1 1 0 1H14v1.5a.5.5 0 1 1-1 0V12h-1.5a.5.5 0 0 1 0-1H13V9.5a.5.5 0 0 1 .5-.5")
      div.titulo-der
        p Nueva publicación
        p Comparte tu momento con la comunidad
    div.form-imgs
      svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-images" viewBox="0 0 16 16")
        path(d="M4.502 9a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3")
        path(d="M14.002 13a2 2 0 0 1-2 2h-10a2 2 0 0 1-2-2V5A2 2 0 0 1 2 3a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v8a2 2 0 0 1-1.998 2M14 2H4a1 1 0 0 0-1 1h9.002a2 2 0 0 1 2 2v7A1 1 0 0 0 15 11V3a1 1 0 0 0-1-1M2.002 4a1 1 0 0 0-1 1v8l2.646-2.354a.5.5 0 0 1 .63-.062l2.66 1.773 3.71-3.71a.5.5 0 0 1 .577-.094l1.777 1.947V5a1 1 0 0 0-1-1z")
      label(for="img") Seleccionar imágenes
      input(type="file" name="img" id="img" multiple)
      p Formatos: JPG, PNG, WebP • Max 10mb
    div#imgsBase64
    div(class="form-group")
      label(for="titulo") Título
      div.form-input
        input(type="text" name="titulo" id="titulo" class="form-control" placeholder="Escribi un título atractivo...")
        p 0/30
    div(class="form-group")
      label(for="descripcion") Descripción
      div.form-descripcion
        input(type="text" name="descripcion" id="descripcion" class="form-control" placeholder="Cuentanos más sobre tu publicación...")
        p 0/100
    input(type="hidden" name="id_usuario" value="1")

    div.form-group
      label(for="etiquetas") Etiquetas
      div.form-input
        div.form-etiqueta
          input(type="text" name="etiquetas[]" id="etiquetas" placeholder="Etiqueta 1")
          button(type="button" id="add-etiqueta")
            svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg" viewBox="0 0 16 16")
              path(fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2")
    div.form-submit
      input(type="submit" value="Subir publicación" class="btn-submit")

    div
      ul#errores(class="errores")

  if imagenes
    h1 Imagen Resultante
    each imagen in imagenes
      p #{imagen.name}
      img(src=imagen.src, style="width:200px")

  script(src="/imgbase64.js")