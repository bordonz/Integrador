mixin item(path, name, active)
  li
    if active
      a(href=path class='active') #{name}
    else 
      a(href=path) #{name}

mixin nav
  nav
    ul
      +item('/publicacion/gallery', 'Home', currentPath == '/publicacion/gallery')
      if !currentUser
        +item('/auth/login', 'Login', currentPath == '/auth/login')
        +item('/auth/signup', 'Sign up', currentPath == '/auth/signup')
      else
        li.nav-user
          form(action="/auth/logout", method="post")
            button(type="submit") Salir
        li.nav-user
          div.nav-user-profile
            a(href=`/usuario/${currentUser.id_usuario}`)
            span #{currentUser.firstName} #{currentUser.lastName}
            //-img(src='/icons/user-svgrepo-com.svg', alt='Usuario', width='22', height='22')
