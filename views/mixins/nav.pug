mixin item(path, name, active)
  li
    if active
      a(href=path class='active') #{name}
    else 
      a(href=path) #{name}

mixin nav
  div.nav-global
    nav
      ul
        +item('/galeria', 'Home', currentPath == '/galeria')
        +item('/publicacion/subir', 'Publicar', currentPath == '/publicacion/subir')
        li.nav-search
          form(action="/buscar", method="get")
            input(type="text" name="buscar" placeholder="Buscar...")
            button(type="submit")
              svg(xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16")
                path(d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0")
        if !currentUser
          +item('/auth/login', 'Login', currentPath == '/auth/login')
          +item('/auth/signup', 'Sign up', currentPath == '/auth/signup')
        else
          li.nav-user
            form(action="/auth/logout", method="post")
              button(type="submit") Salir
          li.nav-user
            div.nav-user-profile
              a(href=`/usuario/${currentUser.id_usuario}`) #{currentUser.firstName} #{currentUser.lastName}
              //-img(src='/icons/user-svgrepo-com.svg', alt='Usuario', width='22', height='22')
